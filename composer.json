{
    "name": "grupofixit/mpesa",
    "description": "SDK oficial do Grupo FixIT para integracao segura com M-Pesa Mocambique (Vodacom)",
    "keywords": [
        "mpesa",
        "vodacom",
        "mozambique",
        "payments",
        "pagamentos",
        "sdk",
        "c2b",
        "b2c",
        "b2b",
        "grupofixit"
    ],
    "homepage": "https://grupofixit.co.mz",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Grupo FixIT Limitada",
            "email": "dev@grupofixit.co.mz",
            "homepage": "https://grupofixit.co.mz"
        }
    ],
    "support": {
        "email": "dev@grupofixit.co.mz",
        "issues": "https://github.com/grupofixit/mpesa/issues",
        "source": "https://github.com/grupofixit/mpesa"
    },
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "GrupoFixIT\\Mpesa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GrupoFixIT\\Mpesa\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable"
}
